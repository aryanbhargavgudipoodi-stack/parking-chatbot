OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# "openai" or "huggingface"
EMBEDDING_BACKEND=openai

# "milvus" (auto-falls back to chroma if unreachable) or "chroma"
VECTOR_BACKEND=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=parking_knowledge
CHROMA_DIR=.chroma_store

SQL_DB_PATH=data/parking_dynamic.db
METADATA_DB_PATH=data/metadata.db
PDF_DIR=data/pdfs

RAG_TOP_K=4
SEMANTIC_BREAKPOINT_TYPE=percentile
SEMANTIC_BREAKPOINT_AMOUNT=90

PII_ENTITIES_BLOCK=CREDIT_CARD,EMAIL_ADDRESS,IBAN_CODE,US_SSN,PHONE_NUMBER